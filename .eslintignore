# These directories hold engine tests, benchmarks, tools, third-party code,
# and internal polyfills that intentionally use eval() and new Function().
# Exclude them to avoid false positives; runtime extensions stay scanned.
benchmarks/
examples/
external/
lib/
test/
tools/
unittests/
utils/

# Non-standalone IIFE fragments concatenated around the scanned extensions.
**/API/hermes/extensions/00-header.js
**/API/hermes/extensions/99-footer.js
