# Do not add a registry or credentials. Dependabot reads this file and cannot
# reach PackageFeedProxy; see "Package feeds" in .ado/scripts/README.md.
omit-lockfile-registry-resolved=true
# Keep equal to the Dependabot npm cooldown. Dependabot applies this setting,
# not its cooldown, when it picks versions for transitive dependencies; see
# "Package feeds" in .ado/scripts/README.md.
min-release-age=8
